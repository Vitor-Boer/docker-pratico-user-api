# Banco local do participante (postgres:16).
# Rodando a API fora do Docker: host localhost.
# Rodando em container na mesma rede Docker do banco: troque o host para `db`
# (o nome do container/serviço), ex.: postgresql://postgres:postgres@db:5432/docker_na_pratica?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docker_na_pratica?schema=public"

PORT=4000
NODE_ENV=development

# Token único recebido no início do evento (URL curta / QR code).
PARTICIPANT_TOKEN="CHANGE_ME"

# URL do hub, definida pelo apresentador (sem barra no final).
HUB_URL="CHANGE_ME"
